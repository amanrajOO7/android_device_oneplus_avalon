soong_namespace {
}

install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6750/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/qca6750/wlan_mac.bin",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/qca6750/WCNSS_qcom_cfg.ini",
    symlink_target: "/odm/vendor/etc/wifi/WCNSS_qcom_cfg.ini",
}

install_symlink {
    name: "sr_models.bin_symlink",
    device_specific: true,
    installed_location: "lib64/sr_models.bin",
    symlink_target: "sr_models.so",
}

install_symlink {
    name: "sr_ref_models.bin_symlink",
    device_specific: true,
    installed_location: "lib64/sr_ref_models.bin",
    symlink_target: "sr_ref_models.so",
}
